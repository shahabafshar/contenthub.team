---
/**
 * Reproduction of the app's own `AISteps` component
 * (`frontend/src/components/messenger/AISteps.jsx`), which is what a ContentHub user
 * actually watches while the assistant works.
 *
 * The real thing has two states, and this renders both:
 *   live     — a bordered "Working…" box, one row per step. Running rows show a spinning
 *              loader and a counting timer; finished rows swap to a check and a fixed
 *              duration.
 *   finished — the box collapses to a single chip, "Worked · N steps · 5.3s", which
 *              expands back to the full list on click.
 *
 * Icons are the same lucide glyphs the app maps each tool slug to, redrawn as inline
 * paths. An unknown slug falls back to the wrench, exactly as `iconFor` does.
 */
/**
 * `mode`:
 *   'live'   — rows start pending and the demo engine drives them (the conversation).
 *   'static' — a frozen snapshot: every step done except the last, which is mid-flight.
 *              Needed anywhere outside the engine's reach, because the rows are hidden
 *              until they carry a state class and would otherwise never appear.
 */
interface Props {
  steps: Array<{ tool: string; label: string; preview?: string; ms: number }>;
  id: string;
  mode?: 'live' | 'static';
}

const { steps, id, mode = 'live' } = Astro.props;
const frozenState = (i: number) =>
  mode === 'static' ? (i < steps.length - 1 ? ' is-done' : ' is-running') : '';

/** Matches the app's `fmtDur`: <10s one decimal, <60s whole seconds, else m + s. */
function fmtDur(ms: number) {
  const s = ms / 1000;
  if (s < 10) return `${s.toFixed(1)}s`;
  if (s < 60) return `${Math.round(s)}s`;
  return `${Math.floor(s / 60)}m ${Math.round(s % 60)}s`;
}

const totalMs = steps.reduce((a, s) => a + (s.ms || 0), 0);
---

<div class="ai-steps" data-ai-steps data-id={id}>
  {/* ── live: the working box ── */}
  <div class="working" data-working role="status" aria-label="Assistant is working">
    {/* Two headers of identical height, swapped in place when the run finishes.
        Swapping rather than replacing the whole box is what keeps the panel a
        constant height while it plays — see the note on `.rows` below. */}
    <p class="working-head" data-head-live>
      <svg class="ic-spark" viewBox="0 0 24 24" aria-hidden="true"><use href="#ai-ic-think" /></svg>
      Working…
    </p>
    <button class="working-head chip" type="button" data-chip aria-expanded="true" hidden>
      <svg class="ic-chev" viewBox="0 0 24 24" aria-hidden="true"><use href="#ai-ic-chevron" /></svg>
      <svg class="ic-spark" viewBox="0 0 24 24" aria-hidden="true"><use href="#ai-ic-think" /></svg>
      Worked · {steps.length} step{steps.length === 1 ? '' : 's'} · {fmtDur(totalMs)}
    </button>
    {
      steps.map((s, i) => (
        <div
          class={`row${frozenState(i)}`}
          data-beat={mode === 'live' ? true : undefined}
          data-wait={mode === 'live' ? s.ms : undefined}
          data-row={i}>
          <span class="state" aria-hidden="true">
            <svg class="ic-run" viewBox="0 0 24 24"><use href="#ai-ic-loader" /></svg>
            <svg class="ic-done" viewBox="0 0 24 24"><use href="#ai-ic-check" /></svg>
          </span>
          <svg class="ic-tool" viewBox="0 0 24 24" aria-hidden="true">
            <use href={`#ai-ic-${s.tool}`} />
          </svg>
          <span class="label">
            {s.label}
            {s.preview && <span class="preview"> — {s.preview}</span>}
          </span>
          {/* Without scripting this is simply the final duration. While the demo
              runs, the engine counts it up in whole seconds and then restores
              `data-final`, which is how the live component behaves. */}
          <span class="dur" data-dur data-final={fmtDur(s.ms)}>{fmtDur(s.ms)}</span>
        </div>
      ))
    }
  </div>

</div>

<style>
  /* `min-width: 0` down the whole chain, plus a clamp on the box: now that
     un-started rows sit in the layout rather than being `display: none`, their
     full label width counts toward intrinsic width and pushed the page past the
     viewport at 390px. A flex/grid child will not shrink below its content
     without this. */
  .ai-steps {
    margin-bottom: 9px;
    direction: ltr;
    min-width: 0;
  }

  /* ── the working box ── */
  .working {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: color-mix(in srgb, var(--surface-2) 70%, transparent);
    padding: 7px 12px 8px;
    min-width: 0;
    overflow: hidden;
  }

  .working-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-3);
    padding-bottom: 2px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 0;
    min-width: 0;
  }

  svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ic-spark {
    color: var(--accent-2);
  }

  .ic-tool {
    color: var(--text-3);
  }

  .state {
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    flex: none;
  }

  .state > svg {
    grid-area: 1 / 1;
  }

  .ic-run {
    color: var(--accent-2);
    animation: ai-spin 0.9s linear infinite;
  }

  .ic-done {
    color: var(--mint);
    display: none;
  }

  @keyframes ai-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .label {
    font-size: 0.76rem;
    color: var(--text);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview {
    color: var(--text-3);
  }

  .dur {
    font-size: 0.66rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    flex: none;
  }

  /* Rows stay in flow at every stage and are revealed by opacity, never by
     `display`. They used to be `display: none` until the engine reached them,
     which grew the panel 108px as the run progressed and shoved the rest of the
     page down with it. Reserving the space up front makes the panel a constant
     height, so nothing outside it moves while the assistant works. */
  .row {
    height: 22px;
  }

  :global(.js) .row {
    opacity: 0.22;
    transition: opacity 0.25s ease;
  }

  :global(.js) .row.is-running,
  :global(.js) .row.is-done {
    opacity: 1;
  }

  /* A row that has not started shows no state icon — it is a placeholder holding
     its own space, not a step claiming to have run. */
  :global(.js) .row:not(.is-running):not(.is-done) .ic-run,
  :global(.js) .row:not(.is-running):not(.is-done) .ic-done,
  :global(.js) .row:not(.is-running):not(.is-done) .dur {
    visibility: hidden;
  }

  /* Finished rows: check instead of spinner, and the label calms down. */
  .row.is-done .ic-run {
    display: none;
  }

  .row.is-done .ic-done {
    display: block;
  }

  .row.is-done .label {
    color: var(--text-3);
  }

  /* ── finished ──
     The box stays; only its header swaps, so finishing costs no height. The rows
     collapse only when the visitor clicks the summary, which is a movement they
     asked for rather than one that happens under them. */
  :global(.js) .ai-steps.is-finished [data-head-live] {
    display: none;
  }

  :global(.js) .ai-steps.is-collapsed .row {
    display: none;
  }

  /* ── the finished summary, which is the box's header once the run ends ──
     `display` on a class beats the UA's `[hidden] { display: none }`, so this
     guard has to come first or the summary leaks into the live state. */
  .chip[hidden] {
    display: none;
  }

  .chip {
    width: 100%;
    text-align: left;
    border-radius: 6px;
    transition: color 0.15s ease;
  }

  .chip:hover {
    color: var(--text);
  }

  .chip .ic-chev {
    transition: transform 0.18s ease;
  }

  .chip[aria-expanded="true"] .ic-chev {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .chip .ic-chev {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ic-run {
      animation: none;
    }
  }
</style>
