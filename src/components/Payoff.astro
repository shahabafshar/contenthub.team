---
import Avatar from './Avatar.astro';
import Rich from './Rich.astro';
import { people, releaseNote as doc } from '../conversation.js';

const author = people[doc.author];
---

<section class="section section-tight" id="outcome">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">What the morning produced</span>
      <h2>The conversation ends as something people can read</h2>
      <p>
        Documents, pages and announcements are first-class objects in the same hub, not
        links to a different product. This is the release note that came out of the thread
        above, as a reader sees it.
      </p>
    </div>

    <article class="window doc reveal">
      <div class="window-bar">
        <span class="window-dots"><i></i><i></i><i></i></span>
        <span class="window-title">
          {doc.breadcrumb.join(' › ')}
        </span>
        <span class="tag-demo">Demo</span>
      </div>

      <div class="doc-body">
        <div class="doc-tags">
          <span class="pill">v{doc.version}</span>
          {doc.tags.map((t) => <span class="tag">#{t}</span>)}
        </div>

        <h3>{doc.title}</h3>

        <div class="byline">
          <Avatar person={author} size="sm" />
          <span class="byline-name">{author.name}</span>
          <span class="byline-sep" aria-hidden="true">·</span>
          <span>{doc.date}</span>
        </div>

        <p class="lead"><Rich text={doc.lead} /></p>

        {
          doc.body.map((part) => (
            <section class="part">
              <h4>{part.heading}</h4>
              <p><Rich text={part.text} /></p>
            </section>
          ))
        }
      </div>
    </article>
  </div>
</section>

<style>
  .doc {
    max-width: 780px;
    margin-inline: auto;
  }

  .doc-body {
    padding: clamp(24px, 4vw, 44px);
  }

  .doc-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .tag {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-2);
  }

  h3 {
    margin-top: 18px;
    font-size: clamp(1.45rem, 3.2vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.16;
  }

  .byline {
    margin-top: 16px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.86rem;
    color: var(--text-3);
  }

  .byline-name {
    font-weight: 600;
    color: var(--text-2);
  }

  .lead {
    margin-top: 22px;
    font-size: 1.08rem;
    line-height: 1.62;
    color: var(--text);
  }

  .part {
    margin-top: 26px;
  }

  .part h4 {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .part p {
    margin-top: 7px;
    color: var(--text-2);
    font-size: 0.97rem;
    line-height: 1.68;
  }
</style>
