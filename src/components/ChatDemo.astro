---
import Avatar from './Avatar.astro';
import Rich from './Rich.astro';
import { people, workspace, stream, self } from '../conversation.js';
import { textDirection } from '../bidi.js';

/**
 * The page's main demo, drawn as the product actually draws a conversation:
 * bubbles, not a flat list. Your own messages sit right-aligned in the primary
 * fill with delivery ticks under them; everyone else's sit left-aligned in the
 * muted fill with the sender's name above — the same shape as `MessageArea.jsx`
 * (`rounded-2xl`, one corner tightened toward the speaker).
 *
 * Every beat is server-rendered in document order and the step engine reveals
 * `[data-beat]` elements one at a time, so with scripting off the whole
 * transcript is present and readable (MANIFEST §8.1), and the controls — which
 * would be inert without JS — are not rendered at all.
 */
const p = (key) => people[key];
const isSelf = (key) => key === self;
---

<section class="section" id="conversation">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Chat · one morning in a channel</span>
      <h2>A bug reported, diagnosed, and written up — without leaving the app</h2>
      <p>
        One continuous conversation: the report, a colleague confirming it, the fix worked
        out in a thread, the call that settled it, and the release note it produced.
      </p>
    </div>

    <div class="demo reveal" data-demo>
      <div class="window">
        <div class="window-bar">
          <span class="window-dots"><i></i><i></i><i></i></span>
          <span class="window-title"># {workspace.channel} — {workspace.name}</span>
          <span class="tag-demo">Demo</span>
        </div>

        <div class="chan">
          <div class="chan-info">
            <p class="chan-name"># {workspace.channel}</p>
            <p class="chan-topic">{workspace.topic}</p>
          </div>
          <div class="chan-people">
            <Avatar person={p('marta')} size="sm" showPresence />
            <Avatar person={p('daniel')} size="sm" showPresence />
            <Avatar person={p('sofia')} size="sm" showPresence />
            <Avatar person={p('kenji')} size="sm" showPresence />
            <span class="chan-count">{workspace.members}</span>
          </div>
        </div>

        <div class="stream">
          {
            stream.map((beat) => {
              const who = p(beat.from);
              const mine = isSelf(beat.from);

              if (beat.kind === 'message') {
                return (
                  <article
                    class={`beat msg${mine ? ' is-mine' : ''}`}
                    data-beat
                    data-wait="1500"
                    data-typing={mine ? undefined : who.first}>
                    {!mine && <Avatar person={who} size="sm" />}
                    <div class="col">
                      {!mine && <p class="name" style={`--hue:${who.hue}`}>{who.name}</p>}

                      <div class="bubble">
                        <p class="body" dir={textDirection(beat.body)} lang={beat.lang}>
                          <Rich text={beat.body} />
                        </p>
                        {beat.gloss && (
                          <p class="gloss" lang="en">
                            <span class="sr-only">Translation: </span>
                            {beat.gloss}
                          </p>
                        )}
                      </div>

                      <p class="meta">
                        <time>{beat.time}</time>
                        {mine && (
                          <span class="ticks" data-ticks>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M18 6 7 17l-4-4" />
                              <path d="m22 8-9 9" />
                            </svg>
                            <span class="sr-only">
                              {beat.receipt ? 'Seen' : 'Delivered'}
                            </span>
                          </span>
                        )}
                      </p>

                      {beat.reactions && (
                        <p class="reacts" data-beat data-wait="700">
                          {beat.reactions.map((r) => (
                            <span class="react">
                              <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2">
                                <ellipse cx="7.6" cy="12" rx="4.4" ry="5.3" />
                                <ellipse cx="16.4" cy="12" rx="4.4" ry="5.3" />
                                <circle cx="7.6" cy="12" r="1.5" fill="currentColor" stroke="none" />
                                <circle cx="16.4" cy="12" r="1.5" fill="currentColor" stroke="none" />
                              </svg>
                              <b>{r.count}</b>
                              <span class="sr-only">{`${r.count} people reacted: ${r.label}`}</span>
                            </span>
                          ))}
                        </p>
                      )}

                      {beat.thread && (
                        <div class="thread" data-beat data-wait="900">
                          <button class="thread-toggle" type="button" aria-expanded="false" data-thread>
                            <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                              <path d="M4 5a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H9.4l-3.7 3.3A1 1 0 0 1 4 17.6V5Z" />
                            </svg>
                            {beat.thread.count} replies
                          </button>

                          <div class="thread-panel">
                            {beat.thread.replies.map((r) => {
                              const rp = p(r.from);
                              return (
                                <div class="reply">
                                  <Avatar person={rp} size="sm" />
                                  <div class="col">
                                    <p class="name" style={`--hue:${rp.hue}`}>
                                      {rp.name} <time>{r.time}</time>
                                    </p>
                                    <div class="bubble">
                                      <p class="body body-sm">
                                        <Rich text={r.body} />
                                      </p>
                                    </div>
                                  </div>
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}
                    </div>
                  </article>
                );
              }


              // kind === 'call'
              return (
                <article class="beat call" data-beat data-wait="1200">
                  <div class="call-icon" aria-hidden="true">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3 7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm14 3.2 3.4-2.4A1 1 0 0 1 22 8.6v6.8a1 1 0 0 1-1.6.8L17 13.8v-3.6Z" />
                    </svg>
                  </div>
                  <div class="call-main">
                    <p class="call-title">{beat.title}</p>
                    <p class="call-sub">
                      Started by {p(beat.from).first} · {beat.duration} · {beat.detail}
                    </p>
                  </div>
                  <div class="call-people">
                    {beat.participants.map((id) => (
                      <Avatar person={p(id)} size="sm" />
                    ))}
                  </div>
                </article>
              );
            })
          }
        </div>

        <!-- JS-only chrome: a constant-height hint above the composer, so the
             message list never reflows when someone starts typing — the same
             constraint the app's TypingIndicator is built around. -->
        <p class="typing" data-typing-row>
          <span data-typing-name></span> is typing
          <span class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </p>

        <div class="composer" aria-hidden="true">
          <span>Message # {workspace.channel}</span>
        </div>
      </div>

      <div class="controls" data-controls>
        <button class="ctl ctl-primary" type="button" data-play>
          <span data-play-icon aria-hidden="true"></span>
          <span data-play-label>Pause</span>
        </button>
        <button class="ctl" type="button" data-restart>Restart</button>
        <p class="status">
          <span data-status>Playing</span>
          <span class="status-sep" aria-hidden="true">·</span>
          <span data-count>0 of 0</span>
        </p>
      </div>
    </div>
  </div>
</section>


<style>
  .demo {
    max-width: 880px;
    margin-inline: auto;
  }

  /* ── channel header ── */
  .chan {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 15px 20px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .chan-info {
    min-width: 0;
  }

  .chan-name {
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .chan-topic {
    font-size: 0.83rem;
    color: var(--text-3);
  }

  .chan-people {
    margin-left: auto;
    display: flex;
    align-items: center;
    flex: none;
  }

  .chan-people :global(.avatar) {
    margin-left: -7px;
    box-shadow: 0 0 0 2px var(--surface);
  }

  .chan-count {
    margin-left: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-3);
  }

  /* ── stream ── */
  .stream {
    padding: 20px 18px 6px;
    display: grid;
    gap: 14px;
  }

  /* Hiding is scoped to .js so the transcript is complete without scripting.
     Ghosted rather than transparent: the beats already occupy their layout
     space, so at zero opacity the panel reads as a large empty box. */
  :global(.js) [data-beat] {
    opacity: 0.06;
    transform: translateY(9px);
    transition: opacity 0.34s ease, transform 0.34s ease;
  }

  :global(.js) [data-beat].is-shown {
    opacity: 1;
    transform: none;
  }

  /* ── message rows ── */
  /* Top-aligned, not bottom-aligned: the column also holds the timestamp,
     reactions and the thread chip, so bottom alignment stranded each avatar far
     below its own bubble. The offset lines it up with the bubble's first line,
     under the sender's name. */
  .msg {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    max-width: 100%;
  }

  .msg > :global(.avatar) {
    margin-top: 21px;
  }

  .msg.is-ai > :global(.avatar) {
    margin-top: 20px;
  }

  /* Your own messages sit on the right with no avatar, as in the app. */
  .msg.is-mine {
    flex-direction: row-reverse;
  }

  /* The assistant's bubble is tall while it works; bottom-aligning its avatar
     would strand it level with the answer instead of its name. */
  .msg.is-ai {
    align-items: flex-start;
  }

  .msg.is-ai .col {
    max-width: 92%;
  }

  .col {
    min-width: 0;
    max-width: 78%;
    display: flex;
    flex-direction: column;
  }

  .msg.is-mine .col {
    align-items: flex-end;
  }

  .name {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 3px;
    /* Identity colour, keyed off the same hue as the avatar. */
    color: hsl(var(--hue) 60% 62%);
  }

  .name time {
    font-weight: 500;
    color: var(--text-3);
    margin-left: 5px;
    font-size: 0.72rem;
  }

  .name-ai {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--violet);
  }

  .badge-ai {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 1px 6px;
    border-radius: 999px;
    color: var(--accent-2);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }

  /* ── the bubble ── */
  .bubble {
    padding: 9px 14px;
    border-radius: 16px;
    border-bottom-left-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
    min-width: 0;
  }

  .msg.is-mine .bubble {
    background: var(--accent);
    color: #fff;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 6px;
  }

  /* The assistant's bubble holds its working box, so it needs room to breathe. */
  .bubble-ai {
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .body {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .body-sm {
    font-size: 0.9rem;
  }

  /* Arabic ascenders and descenders need more room than Latin at the same size.
     Deliberately NO `unicode-bidi: plaintext`: it re-derives direction from the
     first strong character, which is what the majority rule exists to override. */
  .body[dir="rtl"] {
    font-size: 1rem;
    line-height: 1.85;
    text-align: right;
  }

  .gloss {
    margin-top: 5px;
    font-size: 0.8rem;
    font-style: italic;
    opacity: 0.75;
  }

  .msg.is-mine .bubble :global(code) {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  .mention {
    font-weight: 600;
    color: var(--accent-2);
    background: var(--accent-soft);
    border-radius: 5px;
    padding: 0 4px;
    margin-right: 2px;
  }

  .msg.is-mine .mention {
    color: #fff;
    background: rgba(255, 255, 255, 0.22);
  }

  /* ── time + delivery ticks ── */
  .meta {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    font-size: 0.72rem;
    color: var(--text-3);
  }

  .ticks svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--accent-2);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: block;
  }

  /* ── reactions ── */
  .reacts {
    margin-top: 7px;
    display: flex;
    gap: 6px;
  }

  .react {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-soft);
    font-size: 0.8rem;
    color: var(--accent-2);
  }

  .react b {
    font-size: 0.72rem;
  }

  /* ── thread ── */
  .thread {
    margin-top: 8px;
  }

  .thread-toggle {
    display: none;
  }

  :global(.js) .thread-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-2);
    transition: background 0.15s ease;
  }

  :global(.js) .thread-toggle:hover {
    background: var(--surface-2);
  }

  .thread-panel {
    margin-top: 10px;
    padding-left: 13px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    display: grid;
    gap: 11px;
  }

  :global(.js) .thread-panel {
    display: none;
  }

  :global(.js) .thread-panel.is-open {
    display: grid;
  }

  .reply {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .reply > :global(.avatar) {
    margin-top: 19px;
  }

  /* ── assistant answer ── */
  .cites {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .cite {
    font-size: 0.73rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    color: var(--text-3);
    background: var(--surface-2);
  }

  .cite::before {
    content: "↳ ";
    color: var(--accent-2);
  }

  /* ── call banner ── */
  .call {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 15px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--mint) 42%, transparent);
    background: var(--mint-soft);
  }

  .call-icon {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: var(--mint);
    color: #04231f;
  }

  .call-main {
    min-width: 0;
    flex: 1;
  }

  .call-title {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .call-sub {
    font-size: 0.79rem;
    color: var(--text-2);
  }

  .call-people {
    display: flex;
    flex: none;
  }

  .call-people :global(.avatar) {
    margin-left: -7px;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--mint) 20%, var(--bg-raised));
  }

  /* ── typing hint + composer ── */
  .typing {
    display: none;
    align-items: center;
    gap: 6px;
    height: 22px;
    padding-inline: 20px;
    font-size: 0.78rem;
    font-style: italic;
    color: var(--text-3);
  }

  :global(.js) .typing.is-on {
    display: flex;
  }

  .typing-dots {
    display: inline-flex;
    gap: 3px;
  }

  .typing-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-3);
    animation: blink 1.25s ease-in-out infinite;
  }

  .typing-dots i:nth-child(2) {
    animation-delay: 0.18s;
  }

  .typing-dots i:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0.28;
    }
    50% {
      opacity: 1;
    }
  }

  .composer {
    margin: 6px 18px 16px;
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    font-size: 0.83rem;
    color: var(--text-3);
  }

  /* ── controls ── */
  .controls {
    display: none;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
  }

  :global(.js) .controls {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .controls {
      display: none;
    }
  }

  .ctl {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 9px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: 0.87rem;
    font-weight: 600;
    transition: background 0.15s ease;
  }

  .ctl:hover {
    background: var(--surface-2);
  }

  .ctl-primary {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    background: var(--accent-soft);
    color: var(--accent-2);
  }

  .ctl [data-play-icon] {
    font-size: 0.7rem;
    line-height: 1;
  }

  .status {
    margin-left: auto;
    font-size: 0.82rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .status-sep {
    margin-inline: 6px;
  }

  @media (max-width: 640px) {
    .stream {
      padding: 16px 12px 4px;
      gap: 12px;
    }

    .col {
      max-width: 86%;
    }

    .chan {
      padding: 13px 14px;
    }

    .chan-topic {
      display: none;
    }

    .composer {
      margin-inline: 12px;
    }

    .typing {
      padding-inline: 14px;
    }

    .status {
      width: 100%;
      margin-left: 0;
      order: -1;
    }

    .controls {
      flex-wrap: wrap;
    }
  }
</style>
